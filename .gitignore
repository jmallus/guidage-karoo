*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
# Ancré à la racine : « captures/ » sans barre oblique attrape le dossier à n'importe
# quelle profondeur, et emportait donc docs/captures/, où vivent les images du README.
# C'est le dossier de captures d'écran d'Android Studio qu'on veut ignorer, lui seul.
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.keystore
!app/guidage.keystore

# Données cartographiques : elles se comptent en centaines de méga-octets et n'ont
# rien à faire dans l'historique. Elles se téléchargent chez Geofabrik et se copient
# directement sur l'appareil.
*.pbf
*.osm
*.map
*.mbtiles
*.pmtiles

# Le fond de carte est déposé dans les assets par la construction, jamais versionné.
app/src/main/assets/carte.gkmap

# Toile de design assemblée (2 Mio, régénérable depuis design/*.dc.html)
design/*.html
!design/*.dc.html
