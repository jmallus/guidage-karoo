<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:icon="@drawable/ic_guidage"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!--
          Karoo OS lit ce manifeste pour savoir qu'une version plus récente existe, et propose
          « Mise à jour » sur la fiche de l'extension. C'est lui qui va chercher le JSON puis
          l'APK : l'extension, elle, ne demande toujours aucune permission — pas d'INTERNET,
          pas de REQUEST_INSTALL_PACKAGES. La garantie de fonctionnement hors ligne est intacte.

          L'URL « releases/latest » désigne la dernière Release *non* préliminaire, donc le
          dernier tag vX.Y.Z, et jamais la Release « latest », qui est marquée préliminaire et
          suit chaque poussée sur main. Le Karoo ne voit ainsi que les versions publiées
          délibérément. Elle n'est joignable que le dépôt public : c'est Karoo OS qui la
          demande, sans jeton.
        -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="https://github.com/jmallus/guidage-karoo/releases/latest/download/manifest.json" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="io.github.jmallus.guidage.MAIN" />
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".extension.GuidageExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <!-- Permet à Karoo OS de découvrir l'extension -->
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <!-- Champs de données et actions déclarés par l'extension -->
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

    </application>

</manifest>
