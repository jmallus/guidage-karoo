<resources>
    <string name="app_name">Guidance</string>
    <string name="extension_name">Guidance</string>

    <!-- Data fields -->
    <string name="field_profile_name">Route profile ahead</string>
    <string name="field_profile_description">Elevation profile of the route ahead, coloured by gradient.</string>
    <string name="field_fisheye_name">Profile to the finish</string>
    <string name="field_fisheye_description">The whole remaining profile on one band, on a non-linear scale: the first two kilometres take nearly half the width, the rest compresses behind them. The ramp ahead and the fourth-hour col show at once, with no range to change. The unevenly spaced ticks are what tells you the scale is compressed.</string>
    <string name="field_effort_name">Effort budget</string>
    <string name="field_effort_description">What the rest of the route still costs, in kilojoules rather than kilometres, split by item: the rolling terrain, then each remaining climb. The total comes from the estimated time of each item and the power you actually hold in that regime — two measured quantities, none assumed. Needs a power meter.</string>
    <string name="field_climb_name">Next climb</string>
    <string name="field_climb_description">Distance to the next climb, or to the summit of the current one, with gradient and elevation.</string>
    <string name="field_poi_name">Next point of interest</string>
    <string name="field_poi_description">Distance to the next point of interest on the route.</string>

    <string name="field_dashboard_name">Dashboard</string>
    <string name="field_dashboard_description">Full-screen field: route minimap oriented track-up, speed, power, heart rate, cadence, grade, distance remaining and arrival time. Speed, power and heart rate take their zone colour. Tap the field to change the scale.</string>

