<?xml version="1.0" encoding="utf-8"?>
<!--
  Déclaration des capacités de l'extension auprès de Karoo OS.
  L'attribut id doit correspondre à GuidageExtension.EXTENSION_ID,
  et chaque typeId à celui du DataTypeImpl correspondant.
-->
<ExtensionInfo
    id="guidage"
    displayName="@string/extension_name"
    icon="@drawable/ic_guidage"
    scansDevices="false">

    <!--
      Mis de côté avec le fond de carte hors ligne : le Tableau de bord et sa variante
      Gravel (la minicarte), le Tableau de guidage (carte et carrefours). Leur code reste ;
      voir GuidageExtension.types pour les rendre.

    <DataType
        typeId="tableau"
        displayName="@string/field_dashboard_name"
        description="@string/field_dashboard_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="gravel"
        displayName="@string/field_gravel_name"
        description="@string/field_gravel_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="route"
        displayName="@string/field_route_name"
        description="@string/field_route_description"
        graphical="true"
        icon="@drawable/ic_guidage" />
    -->

    <!-- Le champ « Écran Edge » du Garmin du coureur, clair ou sombre selon le thème du Karoo. -->
    <DataType
        typeId="edge"
        displayName="@string/field_edge_name"
        description="@string/field_edge_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="profil"
        displayName="@string/field_profile_name"
        description="@string/field_profile_description"
        graphical="true"
        icon="@drawable/ic_profile" />

    <!-- Le profil de montée seul, le même que celui du Tableau Edge dans une côte. -->
    <DataType
        typeId="montee"
        displayName="@string/field_climb_name"
        description="@string/field_climb_description"
        graphical="true"
        icon="@drawable/ic_climb" />

    <!--
      Les cases de bilan. Elles tiennent dans une case ordinaire, et se posent une à une
      sur une page : c'est pour cela qu'elles existent séparément plutôt qu'en une page unique.
    -->
    <DataType
        typeId="bilan-coeur"
        displayName="@string/field_level_heart_name"
        description="@string/field_level_heart_description"
        graphical="true"
        icon="@drawable/ic_heart_rate" />

    <DataType
        typeId="bilan-puissance"
        displayName="@string/field_level_power_name"
        description="@string/field_level_power_description"
        graphical="true"
        icon="@drawable/ic_power" />

    <DataType
        typeId="bilan-arrivee"
        displayName="@string/field_level_arrival_name"
        description="@string/field_level_arrival_description"
        graphical="true"
        icon="@drawable/ic_bilan_arrivee" />

    <DataType
        typeId="bilan-denivele"
        displayName="@string/field_level_ascent_name"
        description="@string/field_level_ascent_description"
        graphical="true"
        icon="@drawable/ic_bilan_denivele" />

    <DataType
        typeId="bilan-zones"
        displayName="@string/field_level_zones_name"
        description="@string/field_level_zones_description"
        graphical="true"
        icon="@drawable/ic_bilan_zones" />

    <DataType
        typeId="bilan-reserve-w"
        displayName="@string/field_level_reserve_name"
        description="@string/field_level_reserve_description"
        graphical="true"
        icon="@drawable/ic_bilan_reserve" />

    <DataType
        typeId="bilan-arrets"
        displayName="@string/field_level_stops_name"
        description="@string/field_level_stops_description"
        graphical="true"
        icon="@drawable/ic_bilan_arrets" />

    <DataType
        typeId="bilan-batterie"
        displayName="@string/field_level_battery_name"
        description="@string/field_level_battery_description"
        graphical="true"
        icon="@drawable/ic_bilan_batterie" />

</ExtensionInfo>
