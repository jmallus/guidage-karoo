<?xml version="1.0" encoding="utf-8"?>
<!--
  Déclaration des capacités de l'extension auprès de Karoo OS.
  L'attribut id doit correspondre à GuidageExtension.EXTENSION_ID,
  et chaque typeId à celui du DataTypeImpl correspondant.
-->
<ExtensionInfo
    id="guidage"
    displayName="@string/extension_name"
    icon="@drawable/ic_guidage"
    scansDevices="false">

    <DataType
        typeId="tableau"
        displayName="@string/field_dashboard_name"
        description="@string/field_dashboard_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="profil"
        displayName="@string/field_profile_name"
        description="@string/field_profile_description"
        graphical="true"
        icon="@drawable/ic_profile" />

    <DataType
        typeId="cote"
        displayName="@string/field_climb_name"
        description="@string/field_climb_description"
        graphical="true"
        icon="@drawable/ic_climb" />

    <DataType
        typeId="contexte"
        displayName="@string/field_context_name"
        description="@string/field_context_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="reserve"
        displayName="@string/field_resupply_name"
        description="@string/field_resupply_description"
        graphical="true"
        icon="@drawable/ic_poi" />

    <DataType
        typeId="autonomie"
        displayName="@string/field_autonomy_name"
        description="@string/field_autonomy_description"
        graphical="true"
        icon="@drawable/ic_poi" />

    <DataType
        typeId="poi"
        displayName="@string/field_poi_name"
        description="@string/field_poi_description"
        graphical="false"
        icon="@drawable/ic_poi" />

    <!--
      Les six cases de bilan. Elles tiennent dans une case ordinaire, et une page en porte
      dix : c'est pour cela qu'elles existent séparément plutôt qu'en une page unique.
    -->
    <DataType
        typeId="bilan-coeur"
        displayName="@string/field_level_heart_name"
        description="@string/field_level_heart_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="bilan-puissance"
        displayName="@string/field_level_power_name"
        description="@string/field_level_power_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="bilan-arrivee"
        displayName="@string/field_level_arrival_name"
        description="@string/field_level_arrival_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="bilan-denivele"
        displayName="@string/field_level_ascent_name"
        description="@string/field_level_ascent_description"
        graphical="true"
        icon="@drawable/ic_climb" />

    <DataType
        typeId="bilan-intensite"
        displayName="@string/field_level_intensity_name"
        description="@string/field_level_intensity_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="bilan-zones"
        displayName="@string/field_level_zones_name"
        description="@string/field_level_zones_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <DataType
        typeId="bilan-reserve-w"
        displayName="@string/field_level_reserve_name"
        description="@string/field_level_reserve_description"
        graphical="true"
        icon="@drawable/ic_guidage" />

    <BonusAction
        actionId="prochaine-cote"
        displayName="@string/action_next_climb" />
</ExtensionInfo>
